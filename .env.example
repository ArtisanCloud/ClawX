# Optional override environment variables for SynapseX.
# Primary configuration should live in ~/.synapsex/config.json.
# Copy this file to ~/.synapsex/.env only if you need local overrides.

# Use an alternate JSON config path.
# SYNAPSEX_CONFIG=~/.synapsex/config.json

# Optional config-admin allowlist (comma-separated user IDs).
# When set, only these users can run chat config commands like /config plan/apply.
SYNAPSEX_CONFIG_ADMIN_USERS=

# Override backend command used for local execution.
SYNAPSEX_EXEC_COMMAND=
SYNAPSEX_EXEC_ARGS=
SYNAPSEX_EXEC_HEALTH_ARGS=

# Override Discord runtime.
SYNAPSEX_DISCORD_ENABLED=
SYNAPSEX_DISCORD_BOT_TOKEN=
SYNAPSEX_DISCORD_API_BASE_URL=
SYNAPSEX_DISCORD_GATEWAY_URL=
SYNAPSEX_DISCORD_ALLOWED_CHANNEL_IDS=
SYNAPSEX_DISCORD_REQUIRE_MENTION=

# Override Telegram runtime.
SYNAPSEX_TELEGRAM_ENABLED=
SYNAPSEX_TELEGRAM_MODE=
SYNAPSEX_TELEGRAM_TOKEN=
SYNAPSEX_TELEGRAM_BOT_USERNAME=
SYNAPSEX_TELEGRAM_ALLOWED_CHAT_IDS=
SYNAPSEX_TELEGRAM_REQUIRE_COMMAND_OR_MENTION=
SYNAPSEX_TELEGRAM_POLLING_SECONDS=

# Override HTTP and health.
SYNAPSEX_HTTP_LISTEN_ADDR=
SYNAPSEX_HEALTH_PATH=
SYNAPSEX_HEALTH_PROBE_ENABLED=

# Optional: custom runtime log root (default: ~/.synapsex/logs).
SYNAPSEX_LOG_DIR=

# Optional: Override PostgreSQL session persistence (advanced, non-default path).
SYNAPSEX_DATABASE_ENABLED=
SYNAPSEX_DATABASE_DRIVER=
SYNAPSEX_DATABASE_HOST=
SYNAPSEX_DATABASE_PORT=
SYNAPSEX_DATABASE_NAME=
SYNAPSEX_DATABASE_USER=
SYNAPSEX_DATABASE_PASSWORD=
SYNAPSEX_DATABASE_SSLMODE=
SYNAPSEX_DATABASE_AUTO_CREATE=
