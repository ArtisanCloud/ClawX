# Optional override environment variables for ClawX.
# Primary configuration should live in ~/.clawx/config.json.
# Copy this file to ~/.clawx/.env only if you need local overrides.

# Use an alternate JSON config path.
# CLAWX_CONFIG=~/.clawx/config.json

# Optional config-admin allowlist (comma-separated user IDs).
# When set, only these users can run chat config commands like /config plan/apply.
CLAWX_CONFIG_ADMIN_USERS=

# Override backend command used for local execution.
CLAWX_EXEC_COMMAND=
CLAWX_EXEC_ARGS=
CLAWX_EXEC_HEALTH_ARGS=

# Override Discord runtime.
CLAWX_DISCORD_ENABLED=
CLAWX_DISCORD_BOT_TOKEN=
CLAWX_DISCORD_API_BASE_URL=
CLAWX_DISCORD_GATEWAY_URL=
CLAWX_DISCORD_ALLOWED_CHANNEL_IDS=
CLAWX_DISCORD_REQUIRE_MENTION=

# Override Telegram runtime.
CLAWX_TELEGRAM_ENABLED=
CLAWX_TELEGRAM_MODE=
CLAWX_TELEGRAM_TOKEN=
CLAWX_TELEGRAM_BOT_USERNAME=
CLAWX_TELEGRAM_ALLOWED_CHAT_IDS=
CLAWX_TELEGRAM_REQUIRE_COMMAND_OR_MENTION=
CLAWX_TELEGRAM_POLLING_SECONDS=

# Override HTTP and health.
CLAWX_HTTP_LISTEN_ADDR=
CLAWX_HEALTH_PATH=
CLAWX_HEALTH_PROBE_ENABLED=

# Optional: custom runtime log root (default: ~/.clawx/logs).
CLAWX_LOG_DIR=

# Optional: Override PostgreSQL session persistence (advanced, non-default path).
CLAWX_DATABASE_ENABLED=
CLAWX_DATABASE_DRIVER=
CLAWX_DATABASE_HOST=
CLAWX_DATABASE_PORT=
CLAWX_DATABASE_NAME=
CLAWX_DATABASE_USER=
CLAWX_DATABASE_PASSWORD=
CLAWX_DATABASE_SSLMODE=
CLAWX_DATABASE_AUTO_CREATE=
