# SynapseX runtime configuration example
# Copy this file to .env and replace values as needed.

# Allowed working directory roots (comma-separated)
SYNAPSEX_ALLOWED_ROOTS=.

# Default working directory for session execution
SYNAPSEX_DEFAULT_CWD=.

# Maximum execution duration in seconds
SYNAPSEX_TIMEOUT_SECONDS=600

# Backend command used for real local execution
# Use `cat` for smoke testing, or point to your real CLI / wrapper.
SYNAPSEX_EXEC_COMMAND=cat

# Optional extra args for the backend command (space-separated)
SYNAPSEX_EXEC_ARGS=

# Optional health-check args for the backend command (space-separated)
SYNAPSEX_EXEC_HEALTH_ARGS=

# HTTP server
SYNAPSEX_HTTP_LISTEN_ADDR=:8080
SYNAPSEX_HEALTH_PATH=/healthz
SYNAPSEX_HEALTH_PROBE_ENABLED=true

# Discord (currently disabled by default)
SYNAPSEX_DISCORD_ENABLED=true
SYNAPSEX_DISCORD_MODE=interactions
SYNAPSEX_DISCORD_APPLICATION_PUBLIC_KEY=你的_discord_application_public_key
SYNAPSEX_DISCORD_INTERACTIONS_PATH=/discord/interactions

# Telegram
# SYNAPSEX_TELEGRAM_ENABLED=false
# SYNAPSEX_TELEGRAM_MODE=polling
# SYNAPSEX_TELEGRAM_TOKEN=
# SYNAPSEX_TELEGRAM_BOT_USERNAME=
# SYNAPSEX_TELEGRAM_ALLOWED_CHAT_IDS=
# SYNAPSEX_TELEGRAM_REQUIRE_COMMAND_OR_MENTION=true
# SYNAPSEX_TELEGRAM_POLLING_SECONDS=30


