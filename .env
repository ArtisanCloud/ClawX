# ClawX runtime configuration example
# Copy this file to .env and replace values as needed.

# Allowed working directory roots (comma-separated)
CLAWX_ALLOWED_ROOTS=.

# Default working directory for session execution
CLAWX_DEFAULT_CWD=.

# Maximum execution duration in seconds
CLAWX_TIMEOUT_SECONDS=600

# Backend command used for real local execution
# Use `cat` for smoke testing, or point to your real CLI / wrapper.
CLAWX_EXEC_COMMAND=cat

# Optional extra args for the backend command (space-separated)
CLAWX_EXEC_ARGS=

# Optional health-check args for the backend command (space-separated)
CLAWX_EXEC_HEALTH_ARGS=

# HTTP server
CLAWX_HTTP_LISTEN_ADDR=:8080
CLAWX_HEALTH_PATH=/healthz
CLAWX_HEALTH_PROBE_ENABLED=true

# Discord (currently disabled by default)
CLAWX_DISCORD_ENABLED=true
CLAWX_DISCORD_MODE=interactions
CLAWX_DISCORD_APPLICATION_PUBLIC_KEY=你的_discord_application_public_key
CLAWX_DISCORD_INTERACTIONS_PATH=/discord/interactions

# Telegram
# CLAWX_TELEGRAM_ENABLED=false
# CLAWX_TELEGRAM_MODE=polling
# CLAWX_TELEGRAM_TOKEN=
# CLAWX_TELEGRAM_BOT_USERNAME=
# CLAWX_TELEGRAM_ALLOWED_CHAT_IDS=
# CLAWX_TELEGRAM_REQUIRE_COMMAND_OR_MENTION=true
# CLAWX_TELEGRAM_POLLING_SECONDS=30


